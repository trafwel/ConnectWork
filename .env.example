# server
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash   # used once if the main model is overloaded; empty disables
GEMINI_TIER=free            # free | paid  (free => demo data only banner)
ALLOWED_ORIGIN=http://localhost:5173
PORT=8787
DEMO_CACHE=off              # off | record | replay

# web (Vite)
VITE_API_BASE=/api
VITE_GOOGLE_CLIENT_ID=

# --- Side tracks (all optional; features stay off until set) ---
# M16 Photon texting agent (photon.co/beta → dashboard Settings)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
AGENT_ALLOWED_SENDERS=       # comma-separated sender ids (your phone / handle); everyone else is ignored
RELAY_TOKEN=                 # long random string; paste the same value in Settings → Texting agent
# M17 Backboard conversation memory for the texting agent (demo data only)
BACKBOARD_API_KEY=
BACKBOARD_ASSISTANT_ID=
# M15 VEYZL live audit SDK (optional; records prompts/responses — demo data only)
VEYZL_API_KEY=
