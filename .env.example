# server
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# tried in order if the main model is overloaded; empty disables
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# only behind Caddy (M13): use X-Forwarded-For for rate limiting
# TRUST_PROXY=1
# on the VM (M13): listen only for Caddy, never on the public interface
# HOST=127.0.0.1
# free | paid  (free => demo data only banner)
GEMINI_TIER=free
ALLOWED_ORIGIN=http://localhost:5173
PORT=8787
# off | record | replay
DEMO_CACHE=off

# web (Vite)
VITE_API_BASE=/api
VITE_GOOGLE_CLIENT_ID=

# --- Side tracks (all optional; features stay off until set) ---
# M16 Photon texting agent (photon.co/beta → dashboard Settings)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# comma-separated sender ids (your phone / handle); everyone else is ignored
AGENT_ALLOWED_SENDERS=
# long random string; paste the same value in Settings → Texting agent
RELAY_TOKEN=
# M17 Backboard conversation memory for the texting agent (demo data only)
BACKBOARD_API_KEY=
BACKBOARD_ASSISTANT_ID=
# M15 VEYZL live audit SDK (optional; records prompts/responses — demo data only)
VEYZL_API_KEY=
